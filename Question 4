#include <stdio.h>
int main()
{
int crust;
float total;
printf("Select crust type. 1 for regular, 2 for thin, 3 for stuffed.");
scanf("%d",&crust);
switch (crust)
{
case 1:
total=total+0;
break;
case 2:
total=total+1;
break;
case 3:
total=total+2;
break;
default:
printf("Invalid selection.);
break;
}
printf("The updated total bill is %f",total);
}
